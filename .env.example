# Local development. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sql_app.db
SECRET_KEY=change-me-for-local-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# Choose: ollama, gemini, groq, claude
LLM_PROVIDER=ollama
# Choose: ollama, gemini, chroma
EMBEDDING_PROVIDER=ollama

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CHROMA_PERSIST_DIRECTORY=./storage/chroma
DOCUMENT_STORAGE_DIRECTORY=./storage/documents

AI_INPUT_COST_PER_1M_USD=0
AI_OUTPUT_COST_PER_1M_USD=0
