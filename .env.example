# Local development. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sql_app.db
SECRET_KEY=change-me-for-local-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# Choose: ollama, gemini, groq, claude
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDERS=groq,claude
AI_MAX_ATTEMPTS=2
AI_RETRY_BASE_SECONDS=1
# Choose: ollama, gemini, chroma
EMBEDDING_PROVIDER=ollama

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CHROMA_PERSIST_DIRECTORY=./storage/chroma
DOCUMENT_STORAGE_DIRECTORY=./storage/documents

AI_INPUT_COST_PER_1M_USD=0
AI_OUTPUT_COST_PER_1M_USD=0

# Telegram bot integration (optional; create a bot with Telegram's @BotFather)
TELEGRAM_BOT_TOKEN=
# Random 1-256 character secret for Telegram webhook header verification
TELEGRAM_WEBHOOK_SECRET=

# Resource and connection limits
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=500
MAX_INGESTION_CHUNKS=20000
AI_REQUEST_TIMEOUT_SECONDS=45
